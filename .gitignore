# data — versioned by DVC, except the demo sample
/data/raw/
/data/interim/
/data/processed/
!/data/demo/
mlruns/
.dvc/cache/
.dvc/tmp/

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.uv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# hydra
outputs/
multirun/

# reports: everything under tables/ and figures/ is pipeline OUTPUT,
# regenerated by `make demo` / `dvc repro` — never hand-edited or committed.
reports/tables/*
reports/figures/*
reports/data_quality.json
!reports/tables/.gitkeep
!reports/figures/.gitkeep
reports/paper/*.aux
reports/paper/*.log
reports/paper/*.out
reports/paper/*.pdf
reports/paper/*.bbl
reports/paper/*.blg

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
